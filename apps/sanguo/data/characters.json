      "name": "徐晃",
      "group": "wei",
      "role": "平寇将军",
      "firstCh": 13,
      "lastCh": 94,
      "bio": "杨奉部下归曹。关羽围樊城，他击破围城的蜀军。"
    },
    {
      "id": "xuchu",
      "name": "许褚",
      "group": "wei",
      "role": "武卫将军",
      "firstCh": 12,
      "lastCh": 116,
      "bio": "曹操的贴身护卫，人称虎痴。潼关裸衣斗马超。"
    },
    {
      "id": "dianwei",
      "name": "典韦",
      "group": "wei",
      "role": "校尉",
      "firstCh": 10,
      "lastCh": 16,
      "bio": "曹操卫士。宛城之战张绣反，他守寨门，双戟战死。"
    },
    {
      "id": "xunyu",
      "name": "荀彧",
      "group": "wei",
      "role": "侍中",
      "firstCh": 10,
      "lastCh": 61,
      "bio": "曹操的谋主，劝迎天子。后来反对曹操进爵魏公，在寿春打开空食盒，服毒而亡。"
    },
    {
      "id": "xunyou",
      "name": "荀攸",
      "group": "wei",
      "role": "尚书令",
      "firstCh": 2,
      "lastCh": 66,
      "bio": "荀彧之侄。官渡前后屡献奇计，随曹操至死。"
    },
    {
      "id": "guojia",
      "name": "郭嘉",
      "group": "wei",
      "role": "军师祭酒",
      "firstCh": 10,
      "lastCh": 33,
      "bio": "曹操最倚重的谋士。征乌桓途中病死，曹操哭他死得太早。"
    },
    {
      "id": "jiaxu",
      "name": "贾诩",
      "group": "wei",
      "role": "太尉",
      "firstCh": 9,
      "lastCh": 86,
      "bio": "先为李傕谋，又为张绣谋，宛城之仇后归曹操。曹丕夺嫡，他出了关键的一句。"
    },
    {
      "id": "chengyu",
      "name": "程昱",
      "group": "wei",
      "role": "卫尉",
      "firstCh": 10,
      "lastCh": 92,
      "bio": "兖州时为曹操守三城。性烈，曹操说他的性子太急。"
    },
    {
