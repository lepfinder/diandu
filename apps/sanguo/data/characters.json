      "name": "司马懿",
      "group": "wei",
      "role": "太傅",
      "firstCh": 39,
      "lastCh": 108,
      "bio": "曹营后期主将，与诸葛亮对峙渭水。曹芳时与曹爽辅政，嘉平三年病亡。"
    },
    {
      "id": "simashi",
      "name": "司马师",
      "group": "wei",
      "role": "大将军",
      "firstCh": 78,
      "lastCh": 110,
      "bio": "司马懿长子。废曹芳。淮南军中眼瘤迸裂，第一百一十回姜维奏称他新亡。"
    },
    {
      "id": "simazhao",
      "name": "司马昭",
      "group": "wei",
      "role": "晋王",
      "firstCh": 94,
      "lastCh": 119,
      "bio": "司马懿次子。弑曹髦，灭蜀。他死之后，司马炎才代魏。"
    },
    {
      "id": "simayan",
      "name": "司马炎",
      "group": "wei",
      "role": "晋武帝",
      "firstCh": 114,
      "lastCh": 120,
      "bio": "司马昭之子。受魏禅，派杜预、王濬灭吴，三分归晋。"
    },
    {
      "id": "dengai",
      "name": "邓艾",
      "group": "wei",
      "role": "镇西将军",
      "firstCh": 110,
      "lastCh": 119,
      "bio": "偷渡阴平，逼得刘禅出降。钟会诬他谋反，与钟会同死于成都之乱。"
    },
    {
      "id": "zhonghui",
      "name": "钟会",
      "group": "wei",
      "role": "司徒",
      "firstCh": 110,
      "lastCh": 119,
      "bio": "与邓艾分兵灭蜀，又想据蜀自立。姜维将计就计，两人死于成都之乱。"
    },
    {
      "id": "yangxiu",
      "name": "杨修",
      "group": "wei",
      "role": "主簿",
      "firstCh": 60,
      "lastCh": 72,
      "bio": "杨彪之子，才捷。曹操嫌他看破心意，以惑乱军心斩于汉中。"
    },
    {
      "id": "yujin",
      "name": "于禁",
