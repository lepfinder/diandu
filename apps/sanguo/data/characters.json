      "name": "蒋琬",
      "group": "shu",
      "role": "大司马",
      "firstCh": 63,
      "lastCh": 107,
      "bio": "诸葛亮临终推荐的继任者，掌蜀中国政，病故于姜维屡次北伐之前。"
    },
    {
      "id": "feiyi",
      "name": "费祎",
      "group": "shu",
      "role": "尚书令",
      "firstCh": 65,
      "lastCh": 107,
      "bio": "诸葛亮死后与蒋琬先后主持朝政，主和而劝姜维不宜轻动。"
    },
    {
