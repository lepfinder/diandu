      "name": "诸葛亮",
      "group": "shu",
      "role": "蜀汉丞相",
      "firstCh": 36,
      "lastCh": 104,
      "bio": "徐庶走马推荐，刘备三顾出山。取成都、平南中、六出祁山，病逝五丈原。"
    },
    {
      "id": "pangtong",
      "name": "庞统",
      "group": "shu",
      "role": "军师中郎将",
      "firstCh": 35,
      "lastCh": 63,
      "bio": "与诸葛亮并称伏龙凤雏。赤壁后归刘备，取西川时在落凤坡中箭而死。"
    },
    {
      "id": "xushu",
      "name": "徐庶",
      "group": "shu",
      "role": "谋士",
      "firstCh": 36,
      "lastCh": 48,
      "bio": "化名单福投刘备，曹军囚其母，他辞行并走马荐诸葛，此后身在曹营。"
    },
    {
      "id": "fazheng",
      "name": "法正",
      "group": "shu",
      "role": "蜀汉尚书令",
      "firstCh": 60,
      "lastCh": 81,
      "bio": "张松引他结交刘备，取蜀、夺汉中都有他的计。刘备要伐吴时，孔明叹他若在，必能劝住。"
    },
    {
      "id": "guanyu",
      "name": "关羽",
      "group": "shu",
      "role": "蜀汉前将军",
      "firstCh": 1,
      "lastCh": 77,
      "bio": "桃园兄弟。降汉不降曹，千里走单骑，守荆州。麦城突围被擒，不屈而死。"
    },
    {
      "id": "guanping",
      "name": "关平",
      "group": "shu",
      "role": "关羽之子",
      "firstCh": 28,
      "lastCh": 77,
      "bio": "随关羽镇守荆州，麦城突围时与关羽一同被擒。"
    },
    {
      "id": "guanxing",
      "name": "关兴",
      "group": "shu",
      "role": "关羽之子",
      "firstCh": 74,
      "lastCh": 102,
      "bio": "关羽死后随刘备、诸葛亮出征，与张苞并称小将。"
    },
    {
      "id": "zhangfei",
      "name": "张飞",
      "group": "shu",
      "role": "蜀汉车骑将军",
      "firstCh": 1,
      "lastCh": 81,
      "bio": "桃园兄弟。鞭督邮、喝长坂、义释严颜。为关羽报仇起兵，出征前被部将所害。"
    },
    {
      "id": "zhangbao",
      "name": "张苞",
      "group": "shu",
      "role": "张飞之子",
      "firstCh": 81,
      "lastCh": 99,
      "bio": "张飞死后与关兴一同随军，诸葛亮北伐时仍在阵前。"
    },
    {
      "id": "zhaoyun",
      "name": "赵云",
      "group": "shu",
      "role": "蜀汉镇东将军",
      "firstCh": 7,
      "lastCh": 97,
      "bio": "初随公孙瓒，长坂坡救出阿斗。此后一直随刘备、诸葛亮，建兴六年病故。"
    },
    {
      "id": "machao",
      "name": "马超",
      "group": "shu",
      "role": "骠骑将军",
      "firstCh": 10,
      "lastCh": 91,
      "bio": "西凉马腾之子。潼关与曹操大战，后归刘备。诸葛亮南征回来时，已经病故。"
    },
    {
      "id": "huangzhong",
      "name": "黄忠",
      "group": "shu",
      "role": "后将军",
      "firstCh": 53,
      "lastCh": 91,
      "bio": "长沙老将，归刘备后定军山刀劈夏侯渊，列为五虎上将。"
    },
    {
      "id": "weiyan",
      "name": "魏延",
      "group": "shu",
      "role": "蜀汉大将",
      "firstCh": 41,
      "lastCh": 105,
      "bio": "襄阳开城迎刘备，长沙归顺。诸葛亮死后与杨仪争权，在南谷口被马岱所斩。"
    },
    {
      "id": "jiangwei",
      "name": "姜维",
      "group": "shu",
      "role": "大将军",
      "firstCh": 92,
      "lastCh": 119,
      "bio": "天水人，诸葛亮收服后把北伐托给他。蜀亡时假降钟会，事败，与钟会同死于成都之乱。"
    },
    {
      "id": "maliang",
      "name": "马良",
      "group": "shu",
      "role": "侍中",
      "firstCh": 52,
      "lastCh": 87,
      "bio": "白眉马良。夷陵之战为刘备画营图，战败后身死，其弟马谡挂孝来见诸葛亮。"
    },
    {
