  "list": [
    {
      "id": "liubei",
      "name": "刘备",
      "group": "shu",
      "role": "蜀汉先主",
      "firstCh": 1,
      "lastCh": 85,
      "bio": "涿郡起兵，桃园结义。转战徐州、荆州、益州，章武称帝。夷陵大败后在白帝城托孤。"
    },
    {
      "id": "liushan",
      "name": "刘禅",
      "group": "shu",
      "role": "蜀汉后主",
      "firstCh": 34,
      "lastCh": 118,
      "bio": "长坂坡被赵云救出。刘备死后即位，诸葛亮、姜维先后辅政。邓艾兵临成都，他出降。"
    },
    {
