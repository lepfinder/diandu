  ],
  "list": [
    {
      "id": "h001",
      "name": "宋江",
      "group": "tian",
      "role": "呼保义",
      "star": "天魁星",
      "nick": "呼保义",
      "seat": 1,
      "firstCh": 18,
      "lastCh": 120,
      "bio": "郓城县押司。私放晁盖，又因阎婆惜杀死她，发配江州，题反诗后被梁山劫上山。晁盖死在曾头市，他坐了第一把交椅，把人马带到招安。",
      "image": "/characters/h001.webp"
    },
    {
      "id": "h002",
      "name": "卢俊义",
      "group": "tian",
      "role": "玉麒麟",
      "star": "天罡星",
      "nick": "玉麒麟",
      "seat": 2,
      "firstCh": 60,
      "lastCh": 120,
      "bio": "北京大名府员外，棍棒天下闻名。吴用用卦歌把他赚出门，燕青一路跟着。回家后被李固、贾氏陷害，石秀跳楼劫法场，他才上山，坐第二位。",
      "image": "/characters/h002.webp"
    },
    {
      "id": "h003",
      "name": "吴用",
      "group": "tian",
      "role": "智多星",
      "star": "天机星",
      "nick": "智多星",
      "seat": 3,
      "firstCh": 14,
      "lastCh": 120,
      "bio": "字学究，东溪村一带的教书先生。智取生辰纲、三打祝家庄、赚卢俊义、破连环马，山寨里的计多半从他这里出。",
      "image": "/characters/h003.webp"
    },
    {
      "id": "h004",
      "name": "公孙胜",
      "group": "tian",
      "role": "入云龙",
      "star": "天闲星",
      "nick": "入云龙",
      "seat": 4,
      "firstCh": 15,
      "lastCh": 120,
      "bio": "蓟州人，罗真人的徒弟。七星聚义时来找晁盖，后来回蓟州探母，戴宗、李逵再把他请出山。高廉的妖法、芒砀山樊瑞，都是他破的。",
      "image": "/characters/h004.webp"
    },
    {
      "id": "h005",
      "name": "关胜",
      "group": "tian",
      "role": "大刀",
      "star": "天勇星",
      "nick": "大刀",
      "seat": 5,
      "firstCh": 63,
      "lastCh": 120,
      "bio": "关羽之后，使一口青龙偃月刀。朝廷派他领兵取梁山，呼延灼把话说到他心里，他归了山寨。",
      "image": "/characters/h005.webp"
    },
    {
      "id": "h006",
      "name": "林冲",
      "group": "tian",
      "role": "豹子头",
      "star": "天雄星",
      "nick": "豹子头",
      "seat": 6,
      "firstCh": 7,
      "lastCh": 119,
      "bio": "东京八十万禁军枪棒教头。高衙内要他的妻子，白虎堂、野猪林、草料场一路逼下来。山神庙杀了陆谦，雪夜上梁山，后来火并王伦。",
      "image": "/characters/h006.webp"
    },
    {
      "id": "h007",
      "name": "秦明",
      "group": "tian",
      "role": "霹雳火",
      "star": "天猛星",
      "nick": "霹雳火",
      "seat": 7,
      "firstCh": 34,
      "lastCh": 119,
      "bio": "青州指挥司统制，使一条狼牙棒。花荣用计把他引到山上，又用他一家的死讯断了他的归路。",
      "image": "/characters/h007.webp"
    },
    {
      "id": "h008",
      "name": "呼延灼",
      "group": "tian",
      "role": "双鞭",
      "star": "天威星",
      "nick": "双鞭",
      "seat": 8,
      "firstCh": 54,
      "lastCh": 120,
      "bio": "呼延赞的后代，善用连环马。第一次来打梁山，钩镰枪破了他的阵，他自己后来也上了山。征辽时，幽州城外擒番将的是他。",
      "image": "/characters/h008.webp"
    },
    {
      "id": "h009",
      "name": "花荣",
      "group": "tian",
      "role": "小李广",
      "star": "天英星",
      "nick": "小李广",
      "seat": 9,
      "firstCh": 22,
      "lastCh": 120,
      "bio": "清风寨武知寨，箭法叫人叫他小李广。宋江在清风寨被刘高陷害，是他带人救的。对影山吕方、郭盛争戟，也是他一箭解开。",
      "image": "/characters/h009.webp"
    },
    {
      "id": "h010",
      "name": "柴进",
      "group": "tian",
      "role": "小旋风",
      "star": "天贵星",
      "nick": "小旋风",
      "seat": 10,
      "firstCh": 9,
      "lastCh": 120,
      "bio": "后周柴世宗的子孙，沧州有丹书铁券。林冲、武松、宋江落难时都住过他的庄。高唐州失陷后被救上山。招安前，他簪花混进东京看灯。",
      "image": "/characters/h010.webp"
    },
    {
      "id": "h011",
      "name": "李应",
      "group": "tian",
      "role": "扑天雕",
      "star": "天富星",
      "nick": "扑天雕",
      "seat": 11,
      "firstCh": 47,
      "lastCh": 120,
      "bio": "独龙冈李家庄庄主。祝家庄和扈家庄之间，他本想两边都不沾。杜兴是他的主管。人被卷进三打祝家庄，此后才上梁山。",
      "image": "/characters/h011.webp"
    },
    {
      "id": "h012",
      "name": "朱仝",
      "group": "tian",
      "role": "美髯公",
      "star": "天满星",
      "nick": "美髯公",
      "seat": 12,
      "firstCh": 13,
      "lastCh": 120,
      "bio": "郓城马兵都头，胡须极长。他放走晁盖，又放走宋江。后来因知府的小衙内死在李逵手里，被吴用设计留在山上。",
      "image": "/characters/h012.webp"
    },
    {
      "id": "h013",
      "name": "鲁智深",
      "group": "tian",
      "role": "花和尚",
      "star": "天孤星",
      "nick": "花和尚",
      "seat": 13,
      "firstCh": 3,
      "lastCh": 119,
      "bio": "原是渭州提辖鲁达。拳打镇关西后在五台山出家，智真长老给他这个法名。大相国寺倒拔垂杨柳，野猪林救林冲。征方腊后在六和寺坐化。",
      "image": "/characters/h013.webp"
    },
    {
      "id": "h014",
      "name": "武松",
      "group": "tian",
      "role": "行者",
      "star": "天伤星",
      "nick": "行者",
      "seat": 14,
      "firstCh": 23,
      "lastCh": 119,
      "bio": "清河人。景阳冈打虎，阳谷县做了都头。杀潘金莲、西门庆，醉打蒋门神，血溅鸳鸯楼，十字坡以后扮了行者。征方腊时断了一臂。",
      "image": "/characters/h014.webp"
    },
    {
      "id": "h015",
      "name": "董平",
      "group": "tian",
      "role": "双鎗将",
      "star": "天立星",
      "nick": "双鎗将",
      "seat": 15,
      "firstCh": 69,
      "lastCh": 119,
      "bio": "东平府兵马都监，双枪。宋江打东平，他先是守城的人。城破之后归顺，坐第十五位。",
      "image": "/characters/h015.webp"
    },
    {
      "id": "h016",
      "name": "张清",
      "group": "tian",
      "role": "没羽箭",
      "star": "天捷星",
      "nick": "没羽箭",
      "seat": 16,
      "firstCh": 70,
      "lastCh": 119,
      "bio": "东昌府猛将，飞石打人，所以叫没羽箭。龚旺、丁得孙是他的副将。征田虎时和琼英结亲。",
      "image": "/characters/h016.webp"
    },
    {
      "id": "h017",
      "name": "杨志",
      "group": "tian",
      "role": "青面兽",
      "star": "天暗星",
      "nick": "青面兽",
      "seat": 17,
      "firstCh": 12,
      "lastCh": 119,
      "bio": "杨令公的后代。花石纲翻了船，殿帅府又不用他。东京卖刀杀了牛二，大名府押送生辰纲，黄泥冈丢了担子，投二龙山，再归梁山。",
      "image": "/characters/h017.webp"
    },
    {
      "id": "h018",
      "name": "徐宁",
      "group": "tian",
      "role": "金鎗手",
      "star": "天祐星",
      "nick": "金鎗手",
      "seat": 18,
      "firstCh": 56,
      "lastCh": 119,
      "bio": "京师金枪班教师，家传钩镰枪。汤隆是他表弟，吴用让时迁偷了他的雁翎甲，把他全家赚上山，用来破呼延灼的连环马。",
      "image": "/characters/h018.webp"
    },
    {
      "id": "h019",
      "name": "索超",
      "group": "tian",
      "role": "急先锋",
      "star": "天空星",
      "nick": "急先锋",
      "seat": 19,
      "firstCh": 13,
      "lastCh": 119,
      "bio": "大名府急先锋，和杨志比武不分胜负。后来留守司派他打梁山，被擒后留下。",
      "image": "/characters/h019.webp"
    },
    {
      "id": "h020",
      "name": "戴宗",
      "group": "tian",
      "role": "神行太保",
      "star": "天速星",
      "nick": "神行太保",
      "seat": 20,
      "firstCh": 36,
      "lastCh": 120,
      "bio": "江州两院押牢节级，腿上拴甲马，能日行八百里。他给蔡九知府传假信，事发后和宋江一同问斩，白龙庙聚义时上山。",
      "image": "/characters/h020.webp"
    },
    {
      "id": "h021",
      "name": "刘唐",
      "group": "tian",
      "role": "赤发鬼",
      "star": "天异星",
      "nick": "赤发鬼",
      "seat": 21,
      "firstCh": 14,
      "lastCh": 119,
      "bio": "东潞州人。夜卧灵官殿，把生辰纲的消息告诉晁盖。宋江杀惜后，他在夜路里追上宋江送金子和信。",
      "image": "/characters/h021.webp"
    },
    {
      "id": "h022",
      "name": "李逵",
      "group": "tian",
      "role": "黑旋风",
      "star": "天杀星",
      "nick": "黑旋风",
      "seat": 22,
      "firstCh": 38,
      "lastCh": 120,
      "bio": "沂州人，江州做小牢子。戴宗引他见宋江。沂岭杀四虎，寿张县乔坐衙，元夜闹东京。招安后和宋江一起死在药酒里。",
      "image": "/characters/h022.webp"
    },
    {
      "id": "h023",
      "name": "史进",
      "group": "tian",
      "role": "九纹龙",
      "star": "天微星",
      "nick": "九纹龙",
      "seat": 23,
      "firstCh": 2,
      "lastCh": 119,
      "bio": "华阴县史家村人，身上刺九条龙。王进教他枪棒。少华山朱武、陈达、杨春与他结识。后来刺配，又和鲁智深在瓦罐寺相遇。",
      "image": "/characters/h023.webp"
    },
    {
      "id": "h024",
      "name": "穆弘",
      "group": "tian",
      "role": "没遮拦",
      "star": "天究星",
      "nick": "没遮拦",
      "seat": 24,
      "firstCh": 37,
      "lastCh": 119,
      "bio": "揭阳镇人，穆春的哥哥。宋江发配过揭阳，被他弟兄追赶。白龙庙之后，兄弟两个都上了梁山。",
      "image": "/characters/h024.webp"
    },
    {
      "id": "h025",
      "name": "雷横",
      "group": "tian",
      "role": "插翅虎",
      "star": "天退星",
      "nick": "插翅虎",
      "seat": 25,
      "firstCh": 13,
      "lastCh": 119,
      "bio": "郓城步兵都头，朱仝的同事。他拿过刘唐，也放过晁盖。后来因白秀英的事打死人，朱仝放他走，投了梁山。",
      "image": "/characters/h025.webp"
    },
    {
      "id": "h026",
      "name": "李俊",
      "group": "tian",
      "role": "混江龙",
      "star": "天寿星",
      "nick": "混江龙",
      "seat": 26,
      "firstCh": 36,
      "lastCh": 119,
      "bio": "庐州人，揭阳岭一带的私商头领。宋江在江州路上得过他的照应。太湖小结义后仍走水路。征方腊结束，他没有随宋江回朝。",
      "image": "/characters/h026.webp"
    },
    {
      "id": "h027",
      "name": "阮小二",
      "group": "tian",
      "role": "立地太岁",
      "star": "天剑星",
      "nick": "立地太岁",
      "seat": 27,
      "firstCh": 15,
      "lastCh": 119,
      "bio": "石碣村渔民，阮氏三兄弟的大哥。吴用说他入伙，黄泥冈上他是划船的人。梁山的水军，东南一寨归他和李俊。",
      "image": "/characters/h027.webp"
    },
    {
      "id": "h028",
      "name": "张横",
      "group": "tian",
      "role": "船火儿",
      "star": "天平星",
      "nick": "船火儿",
      "seat": 28,
      "firstCh": 37,
      "lastCh": 119,
      "bio": "浔阳江上的船户，张顺的哥哥。在江上劫客，宋江差点死在他手里。白龙庙见了宋江，才知道是自己人。",
      "image": "/characters/h028.webp"
    },
    {
      "id": "h029",
      "name": "阮小五",
      "group": "tian",
      "role": "短命二郎",
      "star": "天罪星",
      "nick": "短命二郎",
      "seat": 29,
      "firstCh": 15,
      "lastCh": 119,
      "bio": "阮小二的兄弟。石碣村卖鱼为生，跟吴用去劫生辰纲。梁山水寨里，他和童威守东北。",
      "image": "/characters/h029.webp"
    },
    {
      "id": "h030",
      "name": "张顺",
      "group": "tian",
      "role": "浪里白跳",
      "star": "天损星",
      "nick": "浪里白跳",
      "seat": 30,
      "firstCh": 37,
      "lastCh": 119,
      "bio": "张横的弟弟，水里的本事最好。江州城外先和李逵打架，再认识宋江。征方腊时从涌金门入水，死在水里。",
      "image": "/characters/h030.webp"
    },
    {
      "id": "h031",
      "name": "阮小七",
      "group": "tian",
      "role": "活阎罗",
      "star": "天败星",
      "nick": "活阎罗",
      "seat": 31,
      "firstCh": 15,
      "lastCh": 120,
      "bio": "阮家老三。生辰纲一案里割了何涛的耳朵。梁山水寨西北一路是他和童猛。",
      "image": "/characters/h031.webp"
    },
    {
      "id": "h032",
      "name": "杨雄",
      "group": "tian",
      "role": "病关索",
      "star": "天牢星",
      "nick": "病关索",
      "seat": 32,
      "firstCh": 44,
      "lastCh": 119,
      "bio": "蓟州两院押狱，身上带病，人叫病关索。潘巧云私通和尚，石秀看破，翠屏山上一同杀了她。",
      "image": "/characters/h032.webp"
    },
    {
      "id": "h033",
      "name": "石秀",
      "group": "tian",
      "role": "拼命三郎",
      "star": "天慧星",
      "nick": "拼命三郎",
      "seat": 33,
      "firstCh": 44,
      "lastCh": 119,
      "bio": "杨雄结义的兄弟。翠屏山替杨雄杀了海和尚。北京城卢俊义问斩，他从酒楼上跳下来，先动了手。",
      "image": "/characters/h033.webp"
    },
    {
      "id": "h034",
      "name": "解珍",
      "group": "tian",
      "role": "两头蛇",
      "star": "天暴星",
      "nick": "两头蛇",
      "seat": 34,
      "firstCh": 49,
      "lastCh": 119,
      "bio": "登州猎户，解宝的哥哥。射中的虎被毛太公冒认，兄弟俩入狱。顾大嫂、孙立劫牢，把他们救出，顺路破了祝家庄。",
      "image": "/characters/h034.webp"
    },
    {
      "id": "h035",
      "name": "解宝",
      "group": "tian",
      "role": "双尾蝎",
      "star": "天哭星",
      "nick": "双尾蝎",
      "seat": 35,
      "firstCh": 49,
      "lastCh": 119,
      "bio": "解珍的弟弟，猎户。毛太公一案和哥哥一同下狱，孙新、顾大嫂是他们的亲戚。",
      "image": "/characters/h035.webp"
    },
    {
      "id": "h036",
      "name": "燕青",
      "group": "tian",
      "role": "浪子",
      "star": "天巧星",
      "nick": "浪子",
      "seat": 36,
      "firstCh": 61,
      "lastCh": 119,
      "bio": "卢俊义家里长大的人，会射箭、相扑、吹箫。主人被陷，他去梁山报信。秋林渡射下大雁，劝卢俊义抽身，自己也走了。",
      "image": "/characters/h036.webp"
    },
    {
      "id": "h037",
      "name": "朱武",
      "group": "di",
      "role": "神机军师",
      "star": "地魁星",
      "nick": "神机军师",
      "seat": 37,
      "firstCh": 2,
      "lastCh": 120,
      "bio": "少华山的头领，会排兵布阵。史进为他开了史家村的门。后来在梁山参与军务，征王庆时打破六花阵。",
      "image": "/characters/h037.webp"
    },
    {
      "id": "h038",
      "name": "黄信",
      "group": "di",
      "role": "镇三山",
      "star": "地煞星",
      "nick": "镇三山",
      "seat": 38,
      "firstCh": 33,
      "lastCh": 120,
      "bio": "青州兵马都监。秦明被赚上山之后，他领兵来寻，也被留在山上。",
      "image": "/characters/h038.webp"
    },
    {
      "id": "h039",
      "name": "孙立",
      "group": "di",
      "role": "病尉迟",
      "star": "地勇星",
      "nick": "病尉迟",
      "seat": 39,
      "firstCh": 49,
      "lastCh": 120,
