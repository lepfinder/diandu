{
  "name": "@diandu/honglou",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3434",
    "build": "node ../../scripts/sync-book-public.mjs honglou && NEXT_DIST_DIR=.next next build",
    "build:cf": "node ../../scripts/sync-book-public.mjs honglou && NEXT_DIST_DIR=.next NEXT_PUBLIC_BASE_PATH=/honglou NEXT_PUBLIC_SITE_MODE=assemble next build",
    "start": "NEXT_DIST_DIR=.next next start -p 3434",
    "export:preview": "NEXT_DIST_DIR=.next NEXT_PUBLIC_STATIC_EXPORT=1 next build && node scripts/rewrite-file-protocol.mjs && node scripts/publish.mjs",
    "publish:static": "node scripts/rewrite-file-protocol.mjs && node scripts/publish.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@classic/reader": "workspace:*",
    "@classic/ui": "workspace:*",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.0"
  }
}
