  "items": [
    {
      "id": "laotaitai",
      "category": "address",
      "term": "老太太",
      "aliases": [
        "老祖宗",
        "史太君"
      ],
      "brief": "对家族最高辈女性尊长的敬称",
      "detail": "书中指贾母（史太君）。下人称「老太太」，晚辈或当面有时称「老祖宗」。是荣宁二府名义与人情上的最高权威。",
      "chars": [
        "贾母"
      ],
      "chRef": 3
    },
    {
      "id": "taitai",
      "category": "address",
      "term": "太太",
      "aliases": [
        "太太们"
      ],
      "brief": "对当家主母的敬称",
      "detail": "多指王夫人（宝玉之母）。邢夫人称「大太太」。丫鬟仆妇口中「太太」默认王夫人，因她实际掌内闱。",
      "chars": [
        "王夫人",
        "邢夫人"
      ],
      "chRef": 3
    },
    {
      "id": "nainai",
      "category": "address",
      "term": "奶奶",
      "aliases": [
        "二奶奶",
        "琏二奶奶",
        "珍大奶奶"
      ],
      "detail": "对少奶奶（媳妇辈主母）的敬称。王熙凤为「琏二奶奶」，尤氏为「珍大奶奶」，李纨有时称「大奶奶」。序齿用伯仲排行。",
      "brief": "对媳妇辈主母的敬称，常加排行",
      "chars": [
        "王熙凤",
        "尤氏",
        "李纨"
      ],
      "chRef": 3
    },
    {
      "id": "guniang",
      "category": "address",
      "term": "姑娘",
      "aliases": [
        "姑娘们",
        "丫头"
      ],
      "brief": "未婚小姐，或对丫鬟的称呼",
      "detail": "语境二义：1）府中小姐（林姑娘、宝姑娘、三姑娘）；2）丫鬟（「姑娘们」指丫鬟群体）。需从上下文分辨。",
      "chars": [
        "林黛玉",
        "薛宝钗",
        "贾探春"
      ],
      "chRef": 3
    },
    {
      "id": "ye",
      "category": "address",
      "term": "爷",
      "aliases": [
        "二爷",
        "宝二爷",
        "琏二爷",
        "珍大爷"
      ],
      "brief": "对男主人的敬称，多带排行",
      "detail": "宝玉为「宝二爷」，贾琏为「琏二爷」，贾珍为「珍大爷」，贾环为「环三爷」。排行从族中大排行或房内序齿。",
      "chars": [
        "贾宝玉",
        "贾琏",
        "贾珍"
      ],
      "chRef": 3
    },
    {
      "id": "laoye",
      "category": "address",
      "term": "老爷",
      "aliases": [
        "大老爷",
        "政老爷",
        "赦老爷"
      ],
      "brief": "对长辈男主人的敬称",
      "detail": "贾政「政老爷」、贾赦「大老爷/赦老爷」、贾敬「敬老爷」。下人称当面或背后皆用。",
      "chars": [
        "贾政",
        "贾赦",
        "贾敬"
      ],
      "chRef": 2
    },
    {
      "id": "gongzi",
      "category": "address",
      "term": "公子",
      "aliases": [
        "多情公子",
        "王孙公子"
      ],
      "brief": "对年轻少爷的雅称",
      "detail": "多见于诗词曲文，如判词「多情公子空牵念」指宝玉。日常口语较少用。",
      "chars": [
        "贾宝玉"
      ],
      "chRef": 5
    },
    {
      "id": "xiaoje-yan",
      "category": "address",
      "term": "小姐 / 舍人",
      "aliases": [
        "大姐儿",
        "姑娘"
      ],
      "brief": "主人家未出阁女儿",
      "detail": "「小姐」较晚起口语化，书中多称「姑娘」「大姐儿」。巧姐幼时乳名「大姐儿」。",
      "chars": [
        "巧姐"
      ],
      "chRef": 21
    },
    {
      "id": "momo",
      "category": "address",
      "term": "嬷嬷",
      "aliases": [
        "妈妈",
        "奶子",
        "奶妈"
      ],
      "brief": "年长仆妇，尤指奶母、管事妇",
      "detail": "「嬷嬷/妈妈」可指奶母（李嬷嬷、赵嬷嬷）、管事妇人。地位高于一般丫鬟，可倚老卖老，也可倚势欺人。",
      "chars": [
        "李嬷嬷"
      ],
      "chRef": 3
    },
    {
      "id": "jiade",
      "category": "address",
      "term": "…家的",
      "aliases": [
        "周瑞家的",
        "林之孝家的",
        "赖大家的"
      ],
      "brief": "某管事/陪房之妻的称谓",
      "detail": "「周瑞家的」即周瑞的老婆。多为陪房、管事媳妇，是内宅实际跑腿执行层。姓氏从其夫。",
      "chars": [
        "周瑞家的",
        "林之孝家的"
      ],
      "chRef": 6
    },
    {
      "id": "peifang",
      "category": "address",
      "term": "陪房",
      "aliases": [
        "陪房媳妇",
        "陪嫁丫鬟"
      ],
      "brief": "随嫁的仆妇/丫鬟，心腹一层",
      "detail": "出嫁时带来的娘家仆人，与主子共命运。平儿是凤姐陪嫁丫鬟后收房；王善保家的是邢夫人陪房。是内宅权力网络的毛细血管。",
      "chars": [
        "平儿"
      ],
      "chRef": 44
    },
    {
      "id": "yihuan",
      "category": "address",
      "term": "丫鬟 / 丫头",
      "aliases": [
        "使女",
        "婢女"
      ],
      "brief": "侍女通称，有等级",
      "detail": "一等大丫鬟（袭人、鸳鸯、平儿）、二等、小丫头、粗使。月钱、衣食、是否「准姨娘」待遇皆分等。",
      "chars": [
        "袭人",
        "晴雯",
        "鸳鸯"
      ],
      "chRef": 3
    },
    {
      "id": "qie",
      "category": "address",
      "term": "姨娘",
      "aliases": [
        "赵姨娘",
        "周姨娘",
        "准姨娘"
      ],
      "brief": "妾之通称；「准姨娘」指未行礼的预备",
      "detail": "妾称「姨娘」，地位远低于正室。所生子女为「庶出」。袭人被王夫人内定「准姨娘」例钱，未成礼。",
      "chars": [
        "赵姨娘",
        "袭人"
      ],
      "chRef": 20
    },
    {
      "id": "shuyong",
      "category": "address",
      "term": "主子 / 奴才",
      "aliases": [
        "奴才",
        "小的",
        "家生子"
      ],
      "brief": "主仆对称；「家生子」是家生奴婢",
      "detail": "主子对奴才有生杀予夺之权。家生奴婢世代为奴，如林之孝、赖大皆贾府家生出身后成管家。抄检、打骂、配人皆主子权。",
      "chars": [],
      "chRef": 45
    },
    {
      "id": "jiaosheng",
      "category": "address",
      "term": "世翁 / 年伯 / 老世翁",
      "brief": "官场世交之间的客套",
      "detail": "见于官场应酬，表世交、同年、辈分礼敬。贾雨村与贾府联宗、与甄应嘉往还时多用。",
      "aliases": [
        "世翁"
      ],
      "chars": [
        "贾雨村"
      ],
      "chRef": 2
    },
    {
      "id": "jizhang",
      "category": "dress",
      "term": "箭袖 / 蟒袍",
      "aliases": [
        "蟒衣",
        "箭袖袍"
      ],
      "brief": "行服窄袖；蟒袍为贵近荣显之服",
      "detail": "箭袖便于骑射。蟒袍近龙袍而减等，为公侯贵近所服。宝玉会见北静王等场面多见冠带蟒袍描写。",
      "chars": [
        "贾宝玉",
        "北静王"
      ],
      "chRef": 15
    },
    {
      "id": "quejin-qiu",
      "category": "dress",
      "term": "雀金裘",
      "aliases": [
        "雀金呢",
        "雀金褂"
      ],
      "brief": "俄罗斯进口雀金呢面的珍贵皮裘",
      "detail": "贾母给宝玉的乌云豹氅衣之外的顶级大衣，烧了指顶大洞，京城织补匠不敢揽，晴雯病中用「界线」法补成——即「勇晴雯病补雀金裘」。",
      "chars": [
        "贾宝玉",
        "晴雯"
      ],
      "chRef": 52
    },
    {
      "id": "hongyu-duan",
      "category": "dress",
      "term": "大红羽缎 / 大红猩猩毡",
      "aliases": [
        "羽缎",
        "猩猩毡斗篷"
      ],
      "brief": "御雨雪的高档斗篷料",
      "detail": "羽缎、猩猩毡皆为斗篷面料。雪天芦雪庵、宝玉出门等场景反复出现，是「琉璃世界白雪红梅」的服装色板——红斗篷对白雪。",
      "chars": [
        "贾宝玉",
        "薛宝琴"
      ],
      "chRef": 49
    },
    {
      "id": "huishu-gua",
      "category": "dress",
      "term": "灰鼠褂 / 银鼠褂",
      "aliases": [
        "灰鼠袄",
        "风毛褂"
      ],
      "brief": "以鼠类毛皮作里的短褂",
      "detail": "灰鼠、银鼠为常见皮里冬衣。富家女眷「风毛」（出锋毛领沿）讲究。岫烟衣单、众人斗篷齐全的对比即在此层服装。",
      "chars": [
        "邢岫烟"
      ],
      "chRef": 51
    },
    {
      "id": "bijia",
      "category": "dress",
      "term": "比甲",
      "aliases": [
        "马甲",
        "背心"
      ],
      "brief": "无袖对襟短衣，罩在衫外",
      "detail": "男女皆可服。丫鬟、妇人日常罩衣，便于劳作又成套头搭配。四儿、芳官等伶人做客时常加比甲。",
      "chars": [],
      "chRef": 24
    },
    {
      "id": "doupeng",
      "category": "dress",
      "term": "斗篷 / 氅衣",
      "aliases": [
        "一裹圆",
        "莲青斗纹洋线番丝鹤氅"
      ],
      "brief": "御寒披风；氅衣为长外套",
      "detail": "斗篷披在最外，分雪褂子、猩猩毡、羽缎等。宝琴凫靥裘、宝玉雀金裘皆顶级氅衣。大观园冬景标配。",
      "chars": [
        "薛宝琴",
        "贾宝玉"
      ],
      "chRef": 49
    },
    {
      "id": "xie",
      "category": "dress",
      "term": "膝裤 / 弓鞋 / 潞绸袜",
      "aliases": [
        "鞋面",
        "洒鞋"
      ],
      "brief": "足衣与绣鞋类",
      "detail": "明清女子缠足与弓鞋，书中绣鞋、洒鞋、睡鞋等细写足衣，也暗示身分与情色叙事（如「软衬三春草」）。",
      "chars": [],
      "chRef": 3
    },
    {
      "id": "yun-juan",
      "category": "dress",
      "term": "软烟罗 / 霞影纱",
      "aliases": [
        "银红软烟罗"
      ],
      "brief": "极薄纱罗，「软烟」喻其轻",
      "detail": "刘姥姥进园时贾母论纱：软烟罗有四样颜色，糊窗、作帐皆可。是荣府富贵与审美的物质证据。",
      "chars": [
        "贾母",
        "刘姥姥"
      ],
      "chRef": 40
    },
    {
      "id": "kuang",
      "category": "dress",
      "term": "贾母编 / 鹤氅",
      "aliases": [
        "观音兜",
        "暖兜"
      ],
      "brief": "雪天风帽与披风",
      "detail": "「观音兜」「暖兜」为冬日风帽。贾母雪天出行，暖帽斗篷、竹轿藤轿，服制与出行仪仗一起写富贵。",
      "chars": [
        "贾母"
      ],
      "chRef": 49
    },
    {
      "id": "dai-yu",
      "category": "dress",
      "term": "攒珠勒子 / 八宝坠",
      "aliases": [
        "金八宝坠角",
        "攒珠结"
      ],
      "brief": "额饰、耳坠等头面",
      "detail": "「头面」指首饰套装。勒子束额，坠角为耳坠或流苏。平儿虾须镯、探春累金凤皆头面，也常成盗窃、当当对象。",
      "chars": [
        "平儿",
        "贾探春"
      ],
      "chRef": 52
    },
    {
      "id": "guan-yu",
      "category": "dress",
      "term": "鹡鸰香念珠 / 御赐香珠",
      "aliases": [
        "圣上亲赐鹡鸰香念珠"
      ],
      "brief": "御赐念珠，作礼与信物",
      "detail": "北静王路祭秦可卿时赠宝玉鹡鸰香念珠。后转赠黛玉，黛玉掷而不取——「什么臭男人拿过的」。是权贵交游的物证。",
      "chars": [
        "北静王",
        "贾宝玉",
        "林黛玉"
      ],
      "chRef": 15
    },
    {
      "id": "xiang",
      "category": "dress",
      "term": "宫花 / 堆纱花",
      "aliases": [
        "宫里制的纱花"
      ],
      "brief": "宫制或江南进的假花首饰",
      "detail": "「送宫花周瑞叹英莲」：薛姨妈分宫花十二枝，顺路送出，串起荣府诸芳，也排出亲疏座次。",
      "chars": [
        "薛姨妈",
        "周瑞家的"
      ],
      "chRef": 7
    },
    {
      "id": "tan-yu",
      "category": "dress",
      "term": "二色金百蝶穿花大红箭袖",
      "aliases": [
        "大红箭袖",
        "束发嵌宝紫金冠"
      ],
      "brief": "宝玉出客的华丽行头",
      "detail": "第三回黛玉眼中宝玉：束发嵌宝紫金冠、二色金百蝶穿花大红箭袖、石青起花八团倭缎排穗褂、青缎粉底小朝靴——服制即人物判词。",
      "chars": [
        "贾宝玉"
      ],
      "chRef": 3
    },
    {
      "id": "shu-nv",
      "category": "dress",
      "term": "蜜合色棉袄 / 玫瑰紫二色金银鼠比肩褂",
      "aliases": [
        "蜜合色",
        "玫瑰紫"
      ],
      "brief": "宝钗家常服色，淡雅守分",
      "detail": "第三回写宝钗：一色半新不旧，蜜合色棉袄、玫瑰紫比肩褂、葱黄绫棉裙——不见奢华，是「随分从时」的视觉化。",
      "chars": [
        "薛宝钗"
      ],
      "chRef": 8
    },
    {
      "id": "longjinwei",
      "category": "office",
      "term": "龙禁尉",
      "aliases": [
        "防护内廷紫禁道御前侍卫龙禁尉"
      ],
      "brief": "五品虚衔，多为买赠荣典",
      "detail": "秦可卿死后贾珍为贾蓉捐「龙禁尉」，丧礼题写得以风光。是「捐官」制度与世族虚荣的标本。",
      "chars": [
        "贾蓉",
        "秦可卿"
      ],
      "chRef": 13
    },
    {
      "id": "xunyanyushi",
      "category": "office",
      "term": "巡盐御史 / 兰台寺大夫",
      "aliases": [
        "鹾政",
        "钦点巡盐御史"
      ],
      "brief": "林如海官衔：管盐政的清贵要缺",
      "detail": "「兰台寺大夫」有托古之笔，「钦点巡盐御史」即巡盐御史，掌盐课，是极肥的差。林如海前科探花出身，见其清贵。",
      "chars": [
        "林如海"
      ],
      "chRef": 2
    },
    {
      "id": "jiusheng",
      "category": "office",
      "term": "九省统制 / 九省都检点",
      "aliases": [
        "都太尉统治制县伯"
      ],
      "brief": "王子腾迁转的武职要衔",
      "detail": "王家武荫，王子腾由统制至都检点、内阁大学士，是四大家族「护官符」的权力柱。其升迁与暴亡牵动贾府。",
      "chars": [
        "王子腾"
      ],
      "chRef": 4
    },
    {
      "id": "bugong",
      "category": "office",
      "term": "工部员外郎 / 工部郎中",
      "aliases": [
        "部中",
        "员外郎"
      ],
      "brief": "贾政在工部的京官职",
      "detail": "员外郎为郎中副职，从五品上下。贾政「自幼酷喜读书」却非科甲极显，靠荫保与勤谨。后升郎中、外放学差。",
      "chars": [
        "贾政"
      ],
      "chRef": 2
    },
    {
      "id": "yi-deng",
      "category": "office",
      "term": "一等将军 / 三等威烈将军",
      "aliases": [
        "世袭将军",
        "勋旧勋爵"
      ],
      "brief": "贾府世袭的武职勋爵",
      "detail": "宁荣二公之后世袭：贾珍三等威烈将军、贾赦袭一等将军。军功勋爵是四大家族富贵的起点，至书中已是虚架子。",
      "chars": [
        "贾赦",
        "贾珍"
      ],
      "chRef": 2
    },
    {
      "id": "guozijian",
      "category": "office",
      "term": "国子监祭酒",
      "aliases": [
        "祭酒"
      ],
      "brief": "李纨之父李守中官职",
      "detail": "国子监长官，掌教育与科举，清贵文职。李纨「族中男女无有不诵诗读书者」的家风由此而来。",
      "chars": [
        "李纨"
      ],
      "chRef": 4
    },
    {
      "id": "jiansheng",
      "category": "office",
      "term": "监生 / 同知",
